diff --git a/drivers/tty/serial/esp32_uart.c b/drivers/tty/serial/esp32_uart.c
index 2405751..0d60a6f 100644
--- a/drivers/tty/serial/esp32_uart.c
+++ b/drivers/tty/serial/esp32_uart.c
@@ -5,6 +5,7 @@
 #include <linux/clk.h>
 #include <linux/console.h>
 #include <linux/delay.h>
+#include <linux/esp32_uart.h>
 #include <linux/io.h>
 #include <linux/irq.h>
 #include <linux/module.h>
@@ -746,6 +747,56 @@ static void esp32_uart_remove(struct platform_device *pdev)
 	uart_remove_one_port(&esp32_uart_reg, port);
 }
 
+/**
+ * esp32_uart_inject_input() - queue bytes as if received on the wire
+ * @line: port line number (0 is ttyS0)
+ * @buf: bytes to queue
+ * @count: number of bytes in @buf
+ *
+ * Pushes data into the tty input queue of the port, exactly like
+ * esp32_uart_rxint() does for bytes read from the RX FIFO.  Nothing is
+ * written to the hardware.  Returns the number of bytes queued, or a
+ * negative error code.
+ */
+int esp32_uart_inject_input(unsigned int line, const u8 *buf, size_t count)
+{
+	struct esp32_port *sport;
+	struct uart_port *port;
+	struct tty_port *tty_port;
+	unsigned long flags;
+	size_t i;
+
+	if (line >= ARRAY_SIZE(esp32_uart_ports))
+		return -EINVAL;
+
+	sport = esp32_uart_ports[line];
+	if (!sport)
+		return -ENODEV;
+
+	port = &sport->port;
+
+	spin_lock_irqsave(&port->lock, flags);
+	if (!port->state) {
+		spin_unlock_irqrestore(&port->lock, flags);
+		return -ENXIO;
+	}
+	tty_port = &port->state->port;
+
+	for (i = 0; i < count; ++i) {
+		if (uart_handle_sysrq_char(port, buf[i]))
+			continue;
+		if (!tty_insert_flip_char(tty_port, buf[i], TTY_NORMAL))
+			break;
+		++port->icount.rx;
+	}
+	spin_unlock_irqrestore(&port->lock, flags);
+
+	tty_flip_buffer_push(tty_port);
+
+	return i;
+}
+EXPORT_SYMBOL_GPL(esp32_uart_inject_input);
+
 
